{
  "name": "sixdegrees",
  "version": "0.0.1",
  "private": true,
  "description": "Chunking + embedding + similarity + fusion search library for notetaker semantic search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
