{
  "name": "sixdegrees-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "build:core": "pnpm -C packages/core build",
    "dev:lab": "pnpm -C packages/lab dev",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
