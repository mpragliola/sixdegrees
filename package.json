{
  "name": "sixdegrees-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "build:core": "pnpm -C packages/core build",
    "dev:lab": "pnpm -C packages/lab dev",
    "typecheck": "pnpm -r --filter=./packages/* typecheck"
  }
}
